# Dependencies / build output
node_modules/
dist/
/.vite

# Secrets & environment — never commit these
.env
server/tenor.key
server/giphy.key
server/youtube.key
server/spotify.key
server/smtp.key
server/vaultline.key
desktop/certs/
# Host-only files the production box keeps beside the checkout: pm2 config (holds JWT_SECRET and
# VAULT_SSO_SECRET), the raw secrets, and deploy leftovers
/ecosystem.config.cjs
/ecosystem.config.cjs.*
/.jwt_secret
/vault-sso.key
/.npmcache/
/bin/
client/dist.*/

# Runtime data (user accounts, uploads, sounds, gifs live on the server's disk)
server/data.sqlite
server/data.sqlite-journal
server/uploads/
server/gifs/
server/sounds/
server/entrances/
server/avatars/
server/tile-icons/
server/app-bundles/
server/feedback-media/
server/downloads/
data/

# Logs
*.log
